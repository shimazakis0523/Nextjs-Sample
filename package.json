{
  "name": "nextjs-sample-bff",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:ci": "eslint --max-warnings 0",
    "lint:json": "eslint --format json --output-file coverage/eslint-results.json",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:coverage": "jest --coverage --json --outputFile=coverage/jest-results.json",
    "test:e2e:json": "playwright test --reporter=json",
    "dashboard:data": "npm run test:coverage; PLAYWRIGHT_JSON_OUTPUT_NAME=playwright-report/results.json npm run test:e2e:json; npm run lint:json; node scripts/generate-test-dashboard-data.mjs",
    "openapi:lint": "redocly lint",
    "openapi:lint:spectral": "spectral lint \"doc/API仕様書/BFF/openapi.yaml\" \"doc/API仕様書/Backend/openapi.yaml\"",
    "openapi:bundle:backend": "redocly bundle doc/API仕様書/Backend/openapi.yaml -o doc/API仕様書/dist/backend.yaml",
    "openapi:types": "openapi-typescript",
    "openapi:mock:backend": "npm run openapi:bundle:backend && prism mock doc/API仕様書/dist/backend.yaml"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@redocly/cli": "^2.49.0",
    "@stoplight/prism-cli": "^5.14.2",
    "@stoplight/spectral-cli": "^6.16.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^30.0.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.5.0",
    "js-yaml": "^4.3.2",
    "openapi-typescript": "^7.13.0",
    "sloc": "^0.3.2",
    "typescript": "^5"
  }
}
